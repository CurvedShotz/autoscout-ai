APP_NAME=AutoScout AI API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
# Use exact origins only (origins do not include paths such as /autoscout).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://danielolowe.com

# Required by the live listing provider.
AUTO_DEV_API_KEY=
# Required by the default query parser, ranking provider, and listing risk analyzer.
GEMINI_API_KEY=
# Optional; only used for ranking when AI_RANKING_PROVIDER=openai.
OPENAI_API_KEY=
AI_RANKING_PROVIDER=gemini
GEMINI_RANKING_MODEL=gemini-3.5-flash-lite
OPENAI_RANKING_MODEL=gpt-5-nano

AUTO_DEV_SEARCH_DISTANCE_MILES=50
LOCATION_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
LOCATION_GEOCODER_USER_AGENT=AutoScoutAI/1.0 (https://danielolowe.com/autoscout/)

# Fixed-window limits applied to POST /search and POST /search/natural, per client address.
SEARCH_RATE_LIMIT_REQUESTS=10
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
